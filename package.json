{
  "name": "simple_pure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/extract-catalog.mjs",
    "images": "node scripts/prepare-images.mjs",
    "predev": "node scripts/extract-catalog.mjs",
    "dev": "next dev -p 3005",
    "prebuild": "node scripts/extract-catalog.mjs",
    "build": "next build",
    "preview": "serve out -l 3005",
    "start": "serve out -l 3005",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-catalog.mjs && tsc --noEmit",
    "audit": "node scripts/verify-catalog.mjs && node scripts/audit-content.mjs && node scripts/audit-links.mjs && tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
